<!DOCTYPE html>

<html lang="pl">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<meta name="theme-color" content="#111111">

<title>Photo Studio AI</title>

<style>

*{box-sizing:border-box}

body{margin:0;background:#111;color:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,sans-serif}

main{max-width:650px;margin:auto;padding:18px}

h1{font-size:27px;margin:8px 0}

p{color:#aaa;line-height:1.5}

.panel{background:#1d1d1d;border:1px solid #333;border-radius:16px;padding:16px;margin:15px 0}

label{display:block;margin:14px 0 7px;font-weight:600}

input,textarea,select,button{width:100%;font:inherit;border-radius:10px;padding:12px}

input,textarea,select{background:#292929;border:1px solid #444;color:white}

textarea{min-height:90px;resize:vertical}

button{border:0;background:#fff;color:#111;font-weight:700;margin-top:12px}

button.secondary{background:#333;color:white}

button:disabled{opacity:.5}

.preview{width:100%;display:block;border-radius:12px;margin-top:12px}

.small{font-size:13px;color:#999}

#status{white-space:pre-wrap;overflow-wrap:anywhere;margin-top:12px}

a{color:#a9d2ff}

</style>

</head>

<body>

<main>

<h1>Photo Studio AI</h1>

<p>Edytor zdjęć AI. Wybierz zdjęcie, opisz zmianę i wyślij do swojego serwera AI.</p>

<section class="panel">

<label for="photo">1. Wybierz zdjęcie</label>

<input id="photo" type="file" accept="image/jpeg,image/png,image/webp">

<img id="preview" class="preview" hidden alt="Podgląd zdjęcia">

<p class="small">Obsługiwane: JPG, PNG, WebP. Maksymalnie 5 MB.</p>

</section>

<section class="panel">

<label for="prompt">2. Opisz, co zmienić</label>

<textarea id="prompt" placeholder="Opisz dokładnie, jak ma wyglądać edytowane zdjęcie..."></textarea>

<label for="preset">Gotowy przykład</label>

<select id="preset">

<option value="">Wybierz przykład</option>

<option value="Change the person's outfit to a classic military woodland camouflage jacket and trousers. Preserve face, identity, pose, background and lighting.">Mundur kamuflażowy</option>

<option value="Change the person's outfit to a simple black dress. Preserve face, identity, pose, background and lighting.">Czarna sukienka</option>

<option value="Change the person's outfit to a denim jacket and jeans. Preserve face, identity, pose, background and lighting.">Ubranie jeansowe</option>

<option value="Change the person's outfit to a plain white T-shirt and dark trousers. Preserve face, identity, pose, background and lighting.">T-shirt i spodnie</option>

<option value="Replace the background with a realistic forest setting. Preserve the person's face, identity and pose.">Tło leśne</option>

</select>

<label for="worker">3. Adres Cloudflare Worker</label>

<input id="worker" type="url" placeholder="https://twoj-worker.twoje-konto.workers.dev">

<label for="password">Kod dostępu</label>

<input id="password" type="password" placeholder="Hasło ustawione w Cloudflare">

<button id="check" class="secondary" type="button">Sprawdź połączenie</button>

<button id="edit" type="button">Edytuj zdjęcie AI</button>

<div id="status" role="status"></div>

</section>

<section class="panel" id="resultPanel" hidden>

<h2>Wynik</h2>

<img id="result" class="preview" alt="Wynik edycji">

<a id="download" href="#" download="photo-studio-ai.png">

<button type="button">Zapisz wynik PNG</button>

</a>

</section>

<p class="small">Uwaga: interfejs wymaga działającego Cloudflare Worker z endpointami /health i /edit. Samo opublikowanie tej strony na GitHub Pages nie uruchamia modelu AI.</p>

</main>

<script>

const photo = document.getElementById("photo");

const preview = document.getElementById("preview");

const promptBox = document.getElementById("prompt");

const preset = document.getElementById("preset");

const workerInput = document.getElementById("worker");

const passwordInput = document.getElementById("password");

const statusBox = document.getElementById("status");

const editButton = document.getElementById("edit");

const checkButton = document.getElementById("check");

let selectedFile = null;

photo.addEventListener("change", () => {

  selectedFile = photo.files && photo.files[0];

  document.getElementById("resultPanel").hidden = true;

  if (!selectedFile) {

    preview.hidden = true;

    return;

  }

  if (!["image/jpeg","image/png","image/webp"].includes(selectedFile.type)) {

    statusBox.textContent = "Wybierz plik JPG, PNG lub WebP.";

    selectedFile = null;

    photo.value = "";

    preview.hidden = true;

    return;

  }

  if (selectedFile.size > 5 * 1024 * 1024) {

    statusBox.textContent = "Zdjęcie jest większe niż 5 MB.";

    selectedFile = null;

    photo.value = "";

    preview.hidden = true;

    return;

  }

  preview.src = URL.createObjectURL(selectedFile);

  preview.hidden = false;

  statusBox.textContent = "";

});

preset.addEventListener("change", () => {

  if (preset.value) promptBox.value = preset.value;

});

function getWorkerUrl() {

  const value = workerInput.value.trim().replace(/\/+$/, "");

  if (!value) throw new Error("Wpisz adres Cloudflare Worker.");

  const url = new URL(value);

  if (url.protocol !== "https:") {

    throw new Error("Adres Workera musi zaczynać się od https://");

  }

  return value;

}

async function requestWithTimeout(url, options = {}) {

  const controller = new AbortController();

  const timer = setTimeout(() => controller.abort(), 120000);

  try {

    return await fetch(url, {

      ...options,

      signal: controller.signal

    });

  } finally {

    clearTimeout(timer);

  }

}

checkButton.addEventListener("click", async () => {

  checkButton.disabled = true;

  statusBox.textContent = "Sprawdzam połączenie...";

  try {

    const base = getWorkerUrl();

    const response = await requestWithTimeout(base + "/health");

    const data = await response.json();

    if (!response.ok) {

      throw new Error(data.error || "Błąd połączenia: " + response.status);

    }

    statusBox.textContent = data.status

      ? "Odpowiedź serwera: " + data.status

      : "Serwer odpowiada poprawnie.";

  } catch (error) {

    statusBox.textContent = "Błąd: " + error.message;

  } finally {

    checkButton.disabled = false;

  }

});

editButton.addEventListener("click", async () => {

  if (!selectedFile) {

    statusBox.textContent = "Najpierw wybierz zdjęcie.";

    return;

  }

  const prompt = promptBox.value.trim();

  if (!prompt) {

    statusBox.textContent = "Wpisz opis zmiany.";

    return;

  }

  editButton.disabled = true;

  checkButton.disabled = true;

  statusBox.textContent = "Wysyłam zdjęcie. Generowanie może potrwać...";

  try {

    const base = getWorkerUrl();

    const form = new FormData();

    form.append("image", selectedFile, selectedFile.name);

    form.append("prompt", prompt);

    const password = passwordInput.value;

    const headers = {};

    if (password) headers["X-App-Password"] = password;

    const response = await requestWithTimeout(base + "/edit", {

      method: "POST",

      headers,

      body: form

    });

    const contentType = response.headers.get("content-type") || "";

    if (!response.ok) {

      let message = "Błąd serwera: " + response.status;

      if (contentType.includes("application/json")) {

        const data = await response.json();

        message = data.error || message;

      } else {

        const text = await response.text();

        if (text) message = text.slice(0, 500);

      }

      throw new Error(message);

    }

    if (!contentType.includes("image/")) {

      const text = await response.text();

      throw new Error("Serwer nie zwrócił obrazu. " + text.slice(0, 300));

    }

    const blob = await response.blob();

    const resultUrl = URL.createObjectURL(blob);

    document.getElementById("result").src = resultUrl;

    const download = document.getElementById("download");

    download.href = resultUrl;

    download.download = "photo-studio-ai.png";

    document.getElementById("resultPanel").hidden = false;

    statusBox.textContent = "Gotowe! Wynik pojawił się poniżej.";

  } catch (error) {

    statusBox.textContent =

      "Nie udało się edytować zdjęcia: " + error.message +

      "\nSprawdź adres Workera, kod dostępu i konfigurację modelu AI.";

  } finally {

    editButton.disabled = false;

    checkButton.disabled = false;

  }

});

</script>

</body>

</html>
